# From Supabase: Project Settings -> Database -> Connection string
# DATABASE_URL = "Transaction pooler" URI (port 6543) - used by the app at runtime
# DIRECT_URL   = "Session pooler" URI (port 5432, same pooler host) - used only by
#                `prisma migrate` from your machine/CI (e.g. the Vercel build step).
#                Do NOT use the "Direct connection" (db.<ref>.supabase.co) host here -
#                it's IPv6-only by default and Vercel's build has no IPv6 egress, so
#                migrations fail with "Can't reach database server" (P1001).
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Staff login password for /pos, /admin, /reports, /receipt
ADMIN_PASSWORD="change-me"

# Secret used to sign the staff login cookie - change this in production
AUTH_SECRET="change-this-to-a-long-random-string"

# Public base URL used to build the QR code order links
# Set this to your real domain when you deploy (e.g. https://your-shop.vercel.app)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Shop name printed on the receipt
NEXT_PUBLIC_SHOP_NAME="ร้านค้าของฉัน"
