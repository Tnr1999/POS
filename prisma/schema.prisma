// Prisma schema for the POS app.
// Money amounts are stored as integers in satang (1 THB = 100 satang) to avoid float rounding errors.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String     @id @default(cuid())
  name      String
  sortOrder Int        @default(0)
  menuItems MenuItem[]
}

model MenuItem {
  id             String          @id @default(cuid())
  name           String
  description    String?
  price          Int
  imageUrl       String?
  active         Boolean         @default(true)
  isFeatured     Boolean         @default(false)
  trackStock     Boolean         @default(false)
  stock          Int             @default(0)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())

  @@index([categoryId])
}

// type: SALE (order placed) | RESTORE (order/item cancelled) | RESTOCK | ADJUSTMENT
model StockMovement {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  type       String
  qtyChange  Int
  note       String?
  createdAt  DateTime @default(now())

  @@index([menuItemId])
}

model Table {
  id        String   @id @default(cuid())
  name      String
  token     String   @unique
  orders    Order[]
  createdAt DateTime @default(now())
}

// status: OPEN | PAID | CANCELLED
// type: DINE_IN | TAKEAWAY
model Order {
  id        String      @id @default(cuid())
  tableId   String?
  table     Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  type      String      @default("DINE_IN")
  status    String      @default("OPEN")
  note      String?
  items     OrderItem[]
  createdAt DateTime    @default(now())
  paidAt    DateTime?

  // Frozen checkout snapshot, set once by payOrder when the order transitions
  // OPEN -> PAID and never touched again afterward (a retried/duplicated
  // payOrder call on an already-PAID order is a no-op — see payOrder's doc
  // comment in src/app/(staff)/pos/actions.ts). All null for every order
  // that predates this feature or was never paid (OPEN/CANCELLED) — read
  // code must treat null here as "not applicable", never guess a value.
  //
  // paymentMethod: CASH | QR_PAYMENT (see src/lib/pricing.ts PAYMENT_METHODS,
  // the single source of truth for the allowed set).
  //
  // All amount fields are integer satang, matching every other money field
  // in this schema. serviceChargeRate/taxRate are integer basis points
  // (1 bp = 0.01%, e.g. 700 = 7.00%) rather than a float percentage, so a
  // rate can never suffer floating-point representation drift once stored -
  // this is what lets a future receipt/report explain exactly how a bill
  // was calculated even after the shop's configured rates change later.
  //
  // subtotalAmount - discountAmount + serviceChargeAmount + taxAmount
  //   = grandTotalAmount
  // changeAmount = paidAmount - grandTotalAmount (always 0 for QR_PAYMENT).
  paymentMethod       String?
  subtotalAmount      Int?
  discountAmount      Int?
  serviceChargeRate   Int?
  serviceChargeAmount Int?
  taxRate             Int?
  taxAmount           Int?
  grandTotalAmount    Int?
  paidAmount          Int?
  changeAmount        Int?

  @@index([tableId])
  @@index([status])
}

// status: PENDING | PREPARING | SERVED | CANCELLED
model OrderItem {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name       String
  price      Int
  qty        Int       @default(1)
  note       String?
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())

  // Set only by the customer QR ordering flow (placeOrder), one unique value
  // per cart line within a single "ส่งออเดอร์" submission — lets a retried
  // or duplicated request detect rows it already created and skip
  // re-inserting them instead of duplicating the order. Null for rows
  // created by staff actions (addItemToOrder/createWalkInOrder), which
  // don't go through this retry-prone path.
  idempotencyKey String? @unique

  @@index([orderId])
}
