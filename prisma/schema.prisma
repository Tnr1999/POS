// Prisma schema for the POS app.
// Money amounts are stored as integers in satang (1 THB = 100 satang) to avoid float rounding errors.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String     @id @default(cuid())
  name      String
  sortOrder Int        @default(0)
  menuItems MenuItem[]
}

model MenuItem {
  id             String          @id @default(cuid())
  name           String
  description    String?
  price          Int
  imageUrl       String?
  active         Boolean         @default(true)
  isFeatured     Boolean         @default(false)
  trackStock     Boolean         @default(false)
  stock          Int             @default(0)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())

  @@index([categoryId])
}

// type: SALE (order placed) | RESTORE (order/item cancelled) | RESTOCK | ADJUSTMENT
model StockMovement {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  type       String
  qtyChange  Int
  note       String?
  createdAt  DateTime @default(now())

  @@index([menuItemId])
}

model Table {
  id        String         @id @default(cuid())
  name      String
  // Legacy per-table QR identity (still required/unique). As of Phase 2D.4,
  // superseded for customer ordering by TableSession.token, which is scoped
  // to one occupancy round instead of the table's entire lifetime — see
  // TableSession below and src/lib/tableSessionAccess.ts. placeOrder, the
  // customer order page, and the polling API no longer resolve against this
  // field at all (no fallback). It remains only for /admin/tables/print's
  // static per-table QR sheet and as the row identity createTable/
  // regenerateTableToken manage; a printed sheet using this token will show
  // customers the expired/unavailable page unless/until a future phase
  // redesigns the print flow around session tokens.
  token     String         @unique
  orders    Order[]
  sessions  TableSession[]
  createdAt DateTime       @default(now())
}

// status: ACTIVE | CLOSED
//
// One occupancy round for a Table: from when staff opens the table for a
// new customer group (Phase 2D.2, not yet implemented) until that round
// ends. TableSession.token is the QR identity for that round — a fresh
// token per session, valid only while status = "ACTIVE" (enforced by
// server actions added in Phase 2D.2, not by anything in this schema
// alone). This is what lets an old session's QR stop working the moment a
// new one starts, without touching Table.token at all.
//
// Invariant: at most one ACTIVE TableSession per Table. Prisma's schema
// language has no declarative support for a partial/conditional unique
// index (a plain `@@unique([tableId])` would forbid more than one CLOSED
// session per table too, which is wrong - a table accumulates many closed
// sessions over its lifetime). The real constraint is a Postgres partial
// unique index added by hand in this migration's SQL:
//   CREATE UNIQUE INDEX ... ON "TableSession"("tableId") WHERE status = 'ACTIVE'
// This is a last-resort safety net, not the primary defense - the actual
// serialization (so two concurrent "open a new session" calls can't even
// reach a constraint violation) is a Table row lock added in Phase 2D.2,
// following the same SELECT ... FOR UPDATE pattern already proven in
// placeOrder/cancelOrder/addItemToOrder/payOrder.
model TableSession {
  id        String    @id @default(cuid())
  tableId   String
  table     Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  token     String    @unique
  status    String    @default("ACTIVE")
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  orders    Order[]

  // Set only by openTableSession (Phase 2D.2), one value per logical "open
  // this table for a new round" request from the caller — lets a retried
  // request (network timeout, the client retrying) detect that this exact
  // request already succeeded and return the session it created, instead
  // of treating the resulting "ACTIVE session, no OPEN order" state as a
  // brand-new "start another round" request. Same idempotency-key pattern
  // as OrderItem.idempotencyKey (Phase 1). Null for every session created
  // before this field existed, and never backfilled.
  idempotencyKey String? @unique

  @@index([tableId])
  @@index([status])
}

// status: OPEN | PAID | CANCELLED
// type: DINE_IN | TAKEAWAY
model Order {
  id             String        @id @default(cuid())
  tableId        String?
  table          Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  // Which TableSession (occupancy round) this order was created in. Set
  // once at creation and never changed afterward (Phase 2D.2+ - this
  // column exists now, but nothing writes it yet, matching how
  // idempotencyKey and the payment-snapshot columns were each added a
  // phase ahead of the code that populates them). Null for every order
  // that predates TableSession existing, and for TAKEAWAY/walk-in orders
  // that were never tied to a table QR at all - never backfilled or
  // guessed for either case.
  tableSessionId String?
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  type           String        @default("DINE_IN")
  status         String        @default("OPEN")
  note           String?
  items          OrderItem[]
  createdAt      DateTime      @default(now())
  paidAt         DateTime?

  // Frozen checkout snapshot, set once by payOrder when the order transitions
  // OPEN -> PAID and never touched again afterward (a retried/duplicated
  // payOrder call on an already-PAID order is a no-op — see payOrder's doc
  // comment in src/app/(staff)/pos/actions.ts). All null for every order
  // that predates this feature or was never paid (OPEN/CANCELLED) — read
  // code must treat null here as "not applicable", never guess a value.
  //
  // paymentMethod: CASH | QR_PAYMENT (see src/lib/pricing.ts PAYMENT_METHODS,
  // the single source of truth for the allowed set).
  //
  // All amount fields are integer satang, matching every other money field
  // in this schema. serviceChargeRate/taxRate are integer basis points
  // (1 bp = 0.01%, e.g. 700 = 7.00%) rather than a float percentage, so a
  // rate can never suffer floating-point representation drift once stored -
  // this is what lets a future receipt/report explain exactly how a bill
  // was calculated even after the shop's configured rates change later.
  //
  // subtotalAmount - discountAmount + serviceChargeAmount + taxAmount
  //   = grandTotalAmount
  // changeAmount = paidAmount - grandTotalAmount (always 0 for QR_PAYMENT).
  paymentMethod       String?
  subtotalAmount      Int?
  discountAmount      Int?
  serviceChargeRate   Int?
  serviceChargeAmount Int?
  taxRate             Int?
  taxAmount           Int?
  grandTotalAmount    Int?
  paidAmount          Int?
  changeAmount        Int?

  @@index([tableId])
  @@index([status])
  @@index([tableSessionId])
}

// status: PENDING | PREPARING | SERVED | CANCELLED
model OrderItem {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name       String
  price      Int
  qty        Int       @default(1)
  note       String?
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())

  // Set only by the customer QR ordering flow (placeOrder), one unique value
  // per cart line within a single "ส่งออเดอร์" submission — lets a retried
  // or duplicated request detect rows it already created and skip
  // re-inserting them instead of duplicating the order. Null for rows
  // created by staff actions (addItemToOrder/createWalkInOrder), which
  // don't go through this retry-prone path.
  idempotencyKey String? @unique

  @@index([orderId])
}
